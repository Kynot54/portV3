# Loaded by `next dev` only (never by `next build`, Vercel, CI or the tests).
# Public test values, no secrets. Real keys live in Vercel (Production only).

# Cloudflare Turnstile's always-pass test site key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Cal.com's public demo calendar (the path after cal.com/).
NEXT_PUBLIC_CAL_LINK=rick/get-rick-rolled
# The form "sends" without calling Resend. Ignored on Vercel.
CONTACT_FAKE_SEND=1
# The Services page and its consultation booking (same demo calendar).
SERVICES_ENABLED=true
NEXT_PUBLIC_CAL_CONSULT_LINK=rick/get-rick-rolled
